{
  "name": "transportation-fleet-logistics-demo",
  "version": "1.0.0",
  "description": "Transportation Fleet Logistics & Smart Dispatch - Oracle 26ai Converged Database Demo",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "verify:brand-colors": "node verification/check-brand-colors.js",
    "verify:contrast": "node verification/check-contrast.js",
    "verify:focus-semantics": "node verification/check-focus-semantics.js",
    "verify:transportation-askdata": "node verification/check-transportation-askdata-contract.js",
    "verify:demo-date-reanchor": "node verification/check-demo-date-reanchor.js",
    "verify:demo-date-windows": "node verification/check-demo-date-windows.js",
    "verify:transportation-source": "node verification/run-transportation-source-verification.js",
    "start": "node backend/server.js",
    "start:prod": "NODE_ENV=production pm2 start backend/server.js --name transportation-fleet-logistics"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "oracledb": "^6.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
